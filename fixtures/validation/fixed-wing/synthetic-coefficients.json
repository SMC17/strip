  "generating_relations": {
    "CX": "-0.04",
    "CY": "-beta",
    "CZ": "-4*alpha",
    "Cl": "0",
    "Cm": "-0.5*alpha",
    "Cn": "0"
  },
  "outside_envelope": "refuse",
  "purpose": "software interpolation, sign, symmetry, and convergence tests only"
}
