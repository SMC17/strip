{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/certification-delta.schema.json",
  "title": "Strip certification-delta (scaffold)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "baseline_digest",
    "candidate_digest",
    "changed_artifacts",
    "required_revalidation",
    "operational_qualification_claimed"
  ],
  "properties": {
    "schema": { "const": "strip.certification-delta.v0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "baseline_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "changed_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "impact"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "impact": { "enum": ["documentation", "model", "validation", "assurance", "flight"] }
        }
      }
    },
    "required_revalidation": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "operational_qualification_claimed": { "const": false }
  }
}
