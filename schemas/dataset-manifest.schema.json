{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/dataset-manifest.schema.json",
  "title": "Strip primary-source dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": { "const": "strip.dataset-manifest.v1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "extractionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_anchor", "extracted_artifact_path", "extracted_artifact_digest"],
      "properties": {
        "citation_anchor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "extracted_artifact_path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "extracted_artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "normalization_script": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "edition", "version", "url", "license", "retrieved_at", "digest", "digest_scope", "extraction", "limitations"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
        "edition": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 96 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 512 },
        "license": { "type": "string", "minLength": 1, "maxLength": 160 },
        "retrieved_at": { "type": "string", "format": "date" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "digest_scope": { "enum": ["source_content", "locator_record", "fixture_content"] },
        "extraction": { "type": "string", "minLength": 1, "maxLength": 512 },
        "extraction_provenance": { "$ref": "#/$defs/extractionProvenance" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
