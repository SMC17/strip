{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/model-package.schema.json",
  "title": "Strip model package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "models"],
  "properties": {
    "schema": { "const": "strip.model-package.v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "model.schema.json" }
    }
  }
}
