{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/model-passport.schema.json",
  "title": "Strip model credibility passport (scaffold)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "version",
    "digest",
    "intended_uses",
    "prohibited_uses",
    "validity_envelope",
    "credibility",
    "operational_qualification_claimed"
  ],
  "properties": {
    "schema": { "const": "strip.model-passport.v0" },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "intended_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "enum": ["education", "research", "preliminary_design", "simulation_training"]
      }
    },
    "prohibited_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "validity_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "minimum", "maximum", "unit"],
      "properties": {
        "variable": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "credibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pedigree", "verification", "validation", "uncertainty", "review"],
      "properties": {
        "pedigree": { "type": "integer", "minimum": 0, "maximum": 4 },
        "verification": { "type": "integer", "minimum": 0, "maximum": 4 },
        "validation": { "type": "integer", "minimum": 0, "maximum": 4 },
        "uncertainty": { "type": "integer", "minimum": 0, "maximum": 4 },
        "review": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "operational_qualification_claimed": { "const": false }
  }
}
