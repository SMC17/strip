{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/model.schema.json",
  "title": "Strip model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "digest", "proof", "provenance", "dependencies", "validity_envelope", "uncertainty_status", "intended_uses"],
  "properties": {
    "schema": { "const": "strip.model.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proof": { "$ref": "#/$defs/proof" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "validity_envelope": { "$ref": "#/$defs/envelope" },
    "uncertainty_status": { "enum": ["quantified", "bounded", "estimated", "unknown", "not_applicable"] },
    "intended_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["education", "research", "preliminary_design", "simulation_training"] }
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "testing", "analysis", "comparison", "validation"],
      "properties": {
        "implementation": { "enum": ["described", "implemented"] },
        "testing": { "enum": ["untested", "unit_tested"] },
        "analysis": { "enum": ["none", "analytical"] },
        "comparison": { "enum": ["none", "cross_implementation", "public_benchmark"] },
        "validation": { "enum": ["none", "experimental", "hil_validated", "accredited", "certification_evidence"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "proof"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "minimum", "maximum", "unit"],
      "properties": {
        "variable": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
