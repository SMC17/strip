{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/run-manifest.schema.json",
  "title": "Strip run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "program_id",
    "started_utc",
    "toolchain",
    "models",
    "inputs",
    "outputs",
    "execution_identity",
    "intended_use",
    "operational_qualification_claimed"
  ],
  "properties": {
    "schema": { "const": "strip.run-manifest.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "program_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "started_utc": { "type": "string", "minLength": 20, "maxLength": 40 },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zig", "host"],
      "properties": {
        "zig": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "jsbsim": { "type": "string" },
        "openvsp": { "type": "string" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "seed": { "type": "integer", "minimum": 0 },
        "campaign_id": { "type": "string" }
      }
    },
    "intended_use": {
      "enum": ["education", "research", "preliminary_design", "simulation_training"]
    },
    "operational_qualification_claimed": { "const": false }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
