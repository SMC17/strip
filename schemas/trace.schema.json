{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/trace.schema.json",
  "title": "Strip execution trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trace_id", "result_id", "steps"],
  "properties": {
    "schema": { "const": "strip.trace.v1" },
    "trace_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "operation", "input_digest", "output_digest", "status"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "operation": { "type": "string", "minLength": 1 },
          "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "output_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "enum": ["completed", "refused", "failed"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
