{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/vehicle.schema.json",
  "title": "Strip bounded vehicle configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "description", "mass_kg", "reference_area_m2", "reference_span_m", "reference_chord_m", "inertia_kg_m2", "validity_envelope", "source_ids"],
  "properties": {
    "schema": { "const": "strip.vehicle.v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "mass_kg": { "type": "number", "minimum": 0.001, "maximum": 100000000 },
    "reference_area_m2": { "type": "number", "minimum": 0.000001, "maximum": 10000000 },
    "reference_span_m": { "type": "number", "minimum": 0.00001, "maximum": 100000 },
    "reference_chord_m": { "type": "number", "minimum": 0.00001, "maximum": 100000 },
    "inertia_kg_m2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xx", "yy", "zz"],
      "properties": {
        "xx": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 },
        "yy": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 },
        "zz": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 },
        "xy": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000, "default": 0 },
        "xz": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000, "default": 0 },
        "yz": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000, "default": 0 }
      }
    },
    "validity_envelope": { "$ref": "#/$defs/envelope" },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    }
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes"],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/axis" }
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "unit", "minimum", "maximum"],
      "properties": {
        "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    }
  }
}
