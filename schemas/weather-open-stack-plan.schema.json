{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-physics.invalid/strip/weather-open-stack-plan.schema.json",
  "title": "Strip open weather stack production plan (scaffold)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plane",
    "authoritative",
    "operational_qualification_claimed",
    "framework",
    "killer_stack",
    "members",
    "calibration",
    "regional"
  ],
  "properties": {
    "schema": { "const": "strip.weather.open-stack.plan.v0" },
    "plane": { "const": "platform" },
    "authoritative": { "const": false },
    "operational_qualification_claimed": { "const": false },
    "framework": { "type": "string", "minLength": 8, "maxLength": 512 },
    "killer_stack": { "type": "string", "minLength": 8, "maxLength": 512 },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "role": {
            "enum": [
              "operational_anchor",
              "frontier_ensemble",
              "large_ensemble_engine",
              "deterministic_detail",
              "regional_refinement",
              "nowcast",
              "calibration_target",
              "reference_baseline",
              "research_only"
            ]
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "calibration": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "regional": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    }
  }
}
