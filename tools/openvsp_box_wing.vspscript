// Build a minimal box-wing model and export ASCII STL for Strip conformance gates.
// __OUTPUT_PATH__ is substituted by tools/openvsp_export.py before invocation.

void main()
{
    string out_path = "__OUTPUT_PATH__";
    ClearVSPModel();

    string fuse_id = AddGeom("FUSELAGE", "");
    SetParmVal(fuse_id, "Length", "Design", 8.0);

    string wing_id = AddGeom("WING", "");
    string wing_span = FindParm(wing_id, "TotalSpan", "WingGeom");
    if (wing_span == "") wing_span = FindParm(wing_id, "Span", "WingGeom");
    if (wing_span == "") wing_span = FindParm(wing_id, "Span", "Design");
    if (wing_span != "") SetParmVal(wing_span, 10.0);
    string wing_root = FindParm(wing_id, "Root_Chord", "XSec_1");
    if (wing_root == "") wing_root = FindParm(wing_id, "Root_Chord", "WingGeom");
    if (wing_root == "") wing_root = FindParm(wing_id, "Root_Chord", "Design");
    if (wing_root != "") SetParmVal(wing_root, 1.5);
    string wing_tip = FindParm(wing_id, "Tip_Chord", "XSec_1");
    if (wing_tip == "") wing_tip = FindParm(wing_id, "Tip_Chord", "WingGeom");
    if (wing_tip == "") wing_tip = FindParm(wing_id, "Tip_Chord", "Design");
    if (wing_tip != "") SetParmVal(wing_tip, 1.5);
    string wing_x = FindParm(wing_id, "X_Rel_Location", "XForm");
    if (wing_x == "") wing_x = FindParm(wing_id, "X_Rel_Location", "Design");
    if (wing_x != "") SetParmVal(wing_x, 2.0);

    string tail_id = AddGeom("WING", "");
    string tail_span = FindParm(tail_id, "TotalSpan", "WingGeom");
    if (tail_span == "") tail_span = FindParm(tail_id, "Span", "WingGeom");
    if (tail_span == "") tail_span = FindParm(tail_id, "Span", "Design");
    if (tail_span != "") SetParmVal(tail_span, 3.0);
    string tail_root = FindParm(tail_id, "Root_Chord", "XSec_1");
    if (tail_root == "") tail_root = FindParm(tail_id, "Root_Chord", "WingGeom");
    if (tail_root == "") tail_root = FindParm(tail_id, "Root_Chord", "Design");
    if (tail_root != "") SetParmVal(tail_root, 0.8);
    string tail_tip = FindParm(tail_id, "Tip_Chord", "XSec_1");
    if (tail_tip == "") tail_tip = FindParm(tail_id, "Tip_Chord", "WingGeom");
    if (tail_tip == "") tail_tip = FindParm(tail_id, "Tip_Chord", "Design");
    if (tail_tip != "") SetParmVal(tail_tip, 0.8);
    string tail_x = FindParm(tail_id, "X_Rel_Location", "XForm");
    if (tail_x == "") tail_x = FindParm(tail_id, "X_Rel_Location", "Design");
    if (tail_x != "") SetParmVal(tail_x, 7.0);
    string tail_z = FindParm(tail_id, "Z_Rel_Location", "XForm");
    if (tail_z == "") tail_z = FindParm(tail_id, "Z_Rel_Location", "Design");
    if (tail_z != "") SetParmVal(tail_z, 1.0);

    Update();
    string mesh_id = ExportFile(out_path, SET_ALL, EXPORT_STL);
    if (mesh_id != "") {
        DeleteGeom(mesh_id);
    }
}
